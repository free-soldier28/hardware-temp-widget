<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="HardwareTempWidget.App.MainWindow"
        Title="HardwareTempWidget"
        Width="160" Height="40"
        CanResize="False"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#CC1E1E28"
        WindowStartupLocation="Manual"
        Icon="/Assets/app.ico"
        PointerPressed="OnPointerPressed">

    <Window.Styles>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Настройки…" Click="OnSettingsClick" />
            <MenuItem x:Name="AutostartMenuItem" Header="Автозапуск" Click="OnToggleAutostartClick" />
            <Separator />
            <MenuItem Header="Выход" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel x:Name="CpuPanel" Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="label" Text="CPU" />
            <TextBlock x:Name="CpuValueText" Classes="value" Text="--°" />
        </StackPanel>
        <StackPanel x:Name="GpuPanel" Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="label" Text="GPU" />
            <TextBlock x:Name="GpuValueText" Classes="value" Text="--°" />
        </StackPanel>
    </StackPanel>
</Window>
