<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="HardwareTempWidget.App.SettingsWindow"
        Title="Настройки — HardwareTempWidget"
        Width="340"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico">

    <StackPanel Margin="16" Spacing="14">
        <StackPanel Spacing="4">
            <TextBlock Text="Прозрачность" />
            <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Интервал опроса (мс)" />
            <NumericUpDown x:Name="IntervalUpDown" Minimum="500" Maximum="10000" Increment="250" FormatString="0" />
        </StackPanel>

        <CheckBox x:Name="AutostartCheckBox" Content="Запускать вместе с Windows" />

        <Separator />

        <StackPanel Spacing="4">
            <TextBlock Text="Отображать на панели" FontWeight="Bold" />
            <CheckBox x:Name="ShowCpuOnPanelCheckBox" Content="CPU" />
            <CheckBox x:Name="ShowGpuOnPanelCheckBox" Content="GPU" />
            <TextBlock x:Name="PanelValidationText"
                       Text="Выберите хотя бы одну температуру для отображения на панели."
                       Foreground="OrangeRed"
                       TextWrapping="Wrap"
                       IsVisible="False" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Температура на значке в трее" FontWeight="Bold" />
            <RadioButton x:Name="TrayCpuRadioButton" GroupName="TrayMetric" Content="CPU" />
            <RadioButton x:Name="TrayGpuRadioButton" GroupName="TrayMetric" Content="GPU" />
        </StackPanel>

        <StackPanel Spacing="4">
            <CheckBox x:Name="OverheatEnabledCheckBox" Content="Уведомлять о перегреве" FontWeight="Bold" />
            <TextBlock Text="Порог перегрева (°C)" />
            <NumericUpDown x:Name="OverheatThresholdUpDown" Minimum="40" Maximum="110" Increment="1" FormatString="0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Отмена" Click="OnCancelClick" />
            <Button Content="Сохранить" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
