<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="HardwareTempWidget.App.SettingsWindow"
        Width="340"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico">

    <StackPanel Margin="16" Spacing="14">
        <StackPanel Spacing="4">
            <TextBlock x:Name="LanguageLabel" />
            <ComboBox x:Name="LanguageComboBox" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="English" />
                <ComboBoxItem Content="Русский" />
            </ComboBox>
        </StackPanel>

        <Separator />

        <StackPanel Spacing="4">
            <TextBlock x:Name="OpacityLabel" />
            <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" />
        </StackPanel>

        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="FontSizeLabel" />
                <TextBlock x:Name="FontSizeValueText" VerticalAlignment="Center" />
            </StackPanel>
            <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="30" />
            <Border Background="#CC1E1E28" CornerRadius="6" Padding="10,4" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="PreviewCpuLabel" Text="CPU" Foreground="#AAAAAA" VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewCpuValue" Text="45°" Foreground="LimeGreen" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="PreviewGpuLabel" Text="GPU" Foreground="#AAAAAA" VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewGpuValue" Text="62°" Foreground="Orange" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="PollIntervalLabel" />
            <NumericUpDown x:Name="IntervalUpDown" Minimum="500" Maximum="10000" Increment="250" FormatString="0" />
        </StackPanel>

        <CheckBox x:Name="AutostartCheckBox" />

        <Separator />

        <StackPanel Spacing="4">
            <TextBlock x:Name="DisplayOnPanelLabel" FontWeight="Bold" />
            <CheckBox x:Name="ShowCpuOnPanelCheckBox" Content="CPU" />
            <CheckBox x:Name="ShowGpuOnPanelCheckBox" Content="GPU" />
            <TextBlock x:Name="PanelValidationText"
                       Foreground="OrangeRed"
                       TextWrapping="Wrap"
                       IsVisible="False" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="CpuModeLabel" FontWeight="Bold" />
            <ComboBox x:Name="CpuModeComboBox" HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="TrayMetricLabel" FontWeight="Bold" />
            <RadioButton x:Name="TrayCpuRadioButton" GroupName="TrayMetric" Content="CPU" />
            <RadioButton x:Name="TrayGpuRadioButton" GroupName="TrayMetric" Content="GPU" />
        </StackPanel>

        <StackPanel Spacing="4">
            <CheckBox x:Name="OverheatEnabledCheckBox" FontWeight="Bold" />
            <TextBlock x:Name="OverheatThresholdLabel" />
            <NumericUpDown x:Name="OverheatThresholdUpDown" Minimum="40" Maximum="110" Increment="1" FormatString="0" />
        </StackPanel>

        <StackPanel x:Name="PerCorePanel" Spacing="4" IsVisible="False">
            <Separator />
            <TextBlock x:Name="PerCoreStatusText" TextWrapping="Wrap" Foreground="OrangeRed" />
            <Button x:Name="InstallDriverButton" Click="OnInstallDriverClick" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Click="OnCancelClick" />
            <Button x:Name="SaveButton" Click="OnSaveClick" />
        </StackPanel>

        <StackPanel Spacing="4">
            <Button x:Name="CheckUpdatesButton" Click="OnCheckUpdatesClick" HorizontalAlignment="Left" />
        </StackPanel>
    </StackPanel>
</Window>
